# --- Required ---
# These are the PRODUCTION values. `expo start` reads the committed
# .env.development first, so local development talks to choner-dev.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
EXPO_PUBLIC_ENV=development

# --- Email (Resend) ---
EXPO_PUBLIC_RESEND_FROM_EMAIL=hello@yourdomain.com

# --- RevenueCat (mobile IAP) ---
EXPO_PUBLIC_REVENUECAT_APPLE_API_KEY=
EXPO_PUBLIC_REVENUECAT_GOOGLE_API_KEY=

# --- Feature gates (see constants/features.ts; default off = hidden) ---
EXPO_PUBLIC_FEATURE_PRO=false

# --- Observability ---
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# --- Server-only secrets (set via `supabase secrets set ...`, not in this file) ---
# RESEND_API_KEY=
# REVENUECAT_WEBHOOK_AUTH=<random secret you also paste into RevenueCat dashboard>
# SUPABASE_SERVICE_ROLE_KEY=<service role key>
# SUPABASE_DB_PASSWORD=<supabase database password>

# --- Maintenance scripts (scripts/README.md) ---
# Default target is choner-dev; CHONER_DB=prod switches to production.
SUPABASE_DEV_DB_PASSWORD=