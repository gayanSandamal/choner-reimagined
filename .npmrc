# Expo SDK 53+ pins react/react-native to exact versions, while some optional
# peers (e.g. react-server-dom-webpack, an unused RSC dependency of expo-router)
# float to newer React ranges. legacy-peer-deps lets npm install the SDK-pinned
# set instead of erroring on those optional peer mismatches. Keep this so local,
# CI, and EAS installs all resolve identically.
legacy-peer-deps=true
