# Upload this beside index.html in the join.choner.io document root.
#
# cPanel shared hosting serves this page with NO Cache-Control and no ETag —
# only Last-Modified — so browsers fall back to heuristic caching. On a form we
# edit daily before launch that is a silent data problem: someone could be
# handed an older copy and submit against an old field list or endpoint.
#
# The host is LiteSpeed, not Apache. LiteSpeed reads .htaccess but does not
# always honour `Header` unless the equivalent of mod_headers is enabled, which
# is what the unconditional rule below tests: if X-Choner-Headers appears in the
# response, the Header directive works and the Cache-Control rule is live too.
# If neither appears, the directive is being ignored and the answer is a support
# ticket, not more .htaccess.
Header set X-Choner-Headers "on"
Header set Cache-Control "no-cache, must-revalidate"

# Belt and braces: ExpiresByType is a different module, so if one is available
# and the other is not, we still get revalidation.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# Security headers (security review, 21 November 2026).
# The form posts to the register-first-200 function on Supabase, hence connect-src.
# 'unsafe-inline' stays on script-src and style-src because these pages carry
# their own inline <script> and <style>; removing it needs those moved to files
# first. The CSP still blocks every other origin, plugins, framing and
# base-tag hijacking. Cloudflare's analytics beacon is the one third-party
# script, and Google Fonts the one third-party stylesheet.
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; media-src 'self'; connect-src 'self' https://cloudflareinsights.com https://bkncpybneoqjnkhhchxg.supabase.co; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
</IfModule>
