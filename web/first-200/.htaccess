# Upload this beside index.html in the join.choner.io document root.
#
# cPanel shared hosting serves this page with NO Cache-Control and no ETag —
# only Last-Modified — so browsers fall back to heuristic caching. On a form we
# edit daily before launch that is a silent data problem: someone could be
# handed an older copy and submit against an old field list or endpoint.
#
# The host is LiteSpeed, not Apache. LiteSpeed reads .htaccess but does not
# always honour `Header` unless the equivalent of mod_headers is enabled, which
# is what the unconditional rule below tests: if X-Choner-Headers appears in the
# response, the Header directive works and the Cache-Control rule is live too.
# If neither appears, the directive is being ignored and the answer is a support
# ticket, not more .htaccess.
Header set X-Choner-Headers "on"
Header set Cache-Control "no-cache, must-revalidate"

# Belt and braces: ExpiresByType is a different module, so if one is available
# and the other is not, we still get revalidation.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>
