# app.choner.io (#193). One page answers every invite address:
#   /invite/WALW89  ->  index.html, which reads the code out of the address.
RewriteEngine On
RewriteRule ^invite(/.*)?$ /index.html [L]

# Apple asks for this file with no extension and refuses it unless it is
# served as JSON, with no redirect on the way.
<Files "apple-app-site-association">
  ForceType application/json
</Files>

# Security headers (security review, 21 November 2026).
# Static page, makes no requests of its own.
# 'unsafe-inline' stays on script-src and style-src because these pages carry
# their own inline <script> and <style>; removing it needs those moved to files
# first. The CSP still blocks every other origin, plugins, framing and
# base-tag hijacking. Cloudflare's analytics beacon is the one third-party
# script, and Google Fonts the one third-party stylesheet.
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; media-src 'self'; connect-src 'self' https://cloudflareinsights.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
</IfModule>
