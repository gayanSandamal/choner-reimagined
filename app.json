{
  "expo": {
    "name": "Choner",
    "slug": "choner-mobile",
    "scheme": "choner",
    "version": "0.1.0",
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.choner.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Choner needs access to your photo library to set your profile picture.",
        "NSCameraUsageDescription": "Choner uses the camera for your check-in photos, scanning your partner's code when you meet, and your profile photo.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "usesAppleSignIn": true,
      "associatedDomains": [
        "applinks:choner.app"
      ]
    },
    "android": {
      "package": "com.choner.app",
      "versionCode": 1,
      "permissions": [
        "NOTIFICATIONS"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ],
          "data": [
            {
              "scheme": "https",
              "host": "choner.app"
            }
          ],
          "autoVerify": true
        }
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#FE8C00",
          "mode": "production"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Choner needs access to your photo library to set your profile picture.",
          "cameraPermission": "Choner uses the camera for your check-in photos, scanning your partner's code when you meet, and your profile photo."
        }
      ],
      "@sentry/react-native",
      "expo-asset",
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "Choner uses the camera for your check-in photos, scanning your partner's code when you meet, and your profile photo.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#001827",
          "imageWidth": 200
        }
      ],
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "supabaseUrl": "${SUPABASE_URL}",
      "supabaseAnonKey": "${SUPABASE_ANON_KEY}",
      "resendFromEmail": "${RESEND_FROM_EMAIL}",
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "61b5bfb4-812d-48c7-b136-0c29d9b3e182"
      }
    }
  }
}
