{
  "expo": {
    "name": "Choner",
    "slug": "choner-mobile",
    "scheme": "choner",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#031A2D"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.choner.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Choner needs access to your photo library to set your profile picture.",
        "NSCameraUsageDescription": "Choner uses the camera if you take a profile photo.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "usesAppleSignIn": true,
      "associatedDomains": [
        "applinks:choner.app"
      ]
    },
    "android": {
      "package": "com.choner.app",
      "versionCode": 1,
      "edgeToEdgeEnabled": true,
      "permissions": [
        "NOTIFICATIONS"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ],
          "data": [
            {
              "scheme": "https",
              "host": "choner.app"
            }
          ],
          "autoVerify": true
        }
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#FF8A1F",
          "mode": "production"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Choner needs access to your photo library to set your profile picture.",
          "cameraPermission": "Choner uses the camera if you take a profile photo."
        }
      ],
      "@sentry/react-native",
      "expo-asset",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "supabaseUrl": "${SUPABASE_URL}",
      "supabaseAnonKey": "${SUPABASE_ANON_KEY}",
      "resendFromEmail": "${RESEND_FROM_EMAIL}",
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "61b5bfb4-812d-48c7-b136-0c29d9b3e182"
      }
    }
  }
}
